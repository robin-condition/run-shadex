DEF entry: () => {
    let color_func = (x: f32,y: f32) => {

        let total = x + y;

        let dx = (x - 0.5f32);
        let dy = (y - 0.5f32);
        let distsqr = dx * dx + dy * dy;
        let dist_diff = distsqr - 0.3f32 * 0.3f32;
        let ddiffsqr = 1.0f32 - dist_diff * dist_diff * 60f32;

        (c: u32) => {
            core::sel(cond: c == 0u32, then: ddiffsqr, else: total)
            //ddiffsqr
        }
    };
    core::tex(w: 1920u32, h: 1080u32, d: 3u32, v: color_func)
}